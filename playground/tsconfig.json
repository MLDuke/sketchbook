{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // Browser only. Node types live in tsconfig.node.json — adding "node"
    // here leaks NodeJS.Timeout and `process` into every sketch.
    "types": ["vite/client"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "../entries/*/src"],
  // Tests run under node:test and need Node types; tsconfig.test.json covers them.
  "exclude": ["**/*.test.ts", "../entries/*/src/**/*.test.ts"]
}
